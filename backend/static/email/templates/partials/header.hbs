<mjml>
    <mj-head>
        <mj-title>{{ title }}</mj-title>
        <mj-attributes>
            <mj-all font-family="Helvetica, Arial, sans-serif" />
            <mj-text color="#1f2937" font-size="15px" line-height="1.6" />
            <mj-button background-color="#0b5d47" color="#ffffff" border-radius="8px" font-weight="bold" />
        </mj-attributes>
        <mj-style inline="inline">
            h2 { font-size: 22px; margin: 0 0 8px; color: #111827; }
            h3 { font-size: 16px; margin: 0 0 6px; color: #111827; }
            .muted { color: #6b7280; }
        </mj-style>
    </mj-head>

    <mj-body background-color="#f7f5f0">
        <mj-section padding="24px 0 8px">
            <mj-column>
                <mj-text font-size="22px" font-weight="bold" color="#0b5d47">laptopic</mj-text>
            </mj-column>
        </mj-section>
