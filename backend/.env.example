# Copy to .env and fill in. .env is gitignored — never commit real values.

# "dev" enables the dev mailbox, permissive CORS and the dummy payment handler.
APP_ENV=dev
VENDURE_SERVER_PORT=3000

# Long random strings, e.g. `openssl rand -base64 32`.
COOKIE_SECRET=change-me
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=change-me

# Comma-separated browser origins allowed to call the APIs. Ignored when APP_ENV=dev.
CORS_ORIGINS=

# Postgres from the root docker-compose.yml (`npm run db:up`).
DB_HOST=localhost
DB_PORT=6543
DB_NAME=vendure
DB_USERNAME=vendure
DB_PASSWORD=change-me
DB_SCHEMA=public

# Public URLs. ASSET_URL_PREFIX can stay empty in dev; set it in production.
STOREFRONT_URL=http://localhost:3001
ASSET_URL_PREFIX=

# Public URL of the Vendure server, used for Mollie webhooks. In development use a tunnel,
# e.g. `cloudflared tunnel --url http://localhost:3000`, or webhooks won't reach you.
VENDURE_PUBLIC_URL=http://localhost:3000

# Mollie TEST key (starts with test_), from Mollie Dashboard > Developers > API keys.
# Only in your local .env. `npm run setup:mollie` copies it into the Mollie payment method.
MOLLIE_API_KEY=

# Supplier stock/price feed (CSV, see src/plugins/supplier-sync/supplier-feed.ts). In development it defaults to
# supplier-feed/sample.csv; outside development the nightly sync is off unless this is set.
SUPPLIER_FEED_PATH=

# Email (production only; development writes emails to disk, see http://localhost:3000/mailbox).
# Any SMTP provider works, e.g. Resend, Postmark, Mailgun or your mail host. Port 465 = TLS, 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender, e.g. "Laptopic" <bestellingen@jouwdomein.nl>; must be allowed by your SMTP provider.
EMAIL_FROM=
