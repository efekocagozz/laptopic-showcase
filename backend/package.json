{
  "name": "laptopic-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:server": "vendure dev server",
    "dev:worker": "vendure dev worker",
    "dev:dashboard": "vendure dev dashboard",
    "dev": "vendure dev all",
    "build": "vendure build all",
    "build:server": "vendure build server",
    "build:worker": "vendure build worker",
    "build:dashboard": "vendure build dashboard",
    "start:server": "node ./dist/index.js",
    "start:worker": "node ./dist/index-worker.js",
    "start": "vendure start all",
    "db:up": "docker compose -f ../docker-compose.yml --env-file .env up -d --wait",
    "db:down": "docker compose -f ../docker-compose.yml --env-file .env down",
    "db:reset": "docker compose -f ../docker-compose.yml --env-file .env down -v && npm run db:up",
    "seed": "ts-node src/seed/seed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --project unit",
    "setup:mollie": "ts-node src/seed/setup-mollie.ts",
    "test:e2e": "vitest run --project e2e"
  },
  "allowScripts": {
    "bcrypt": true,
    "esbuild": true,
    "sharp": true
  },
  "dependencies": {
    "@mollie/api-client": "^4.6.0",
    "@vendure-community/mollie-plugin": "^1.0.1",
    "@vendure/asset-server-plugin": "3.8.1",
    "@vendure/core": "3.8.1",
    "@vendure/dashboard": "3.8.1",
    "@vendure/email-plugin": "3.8.1",
    "@vendure/graphiql-plugin": "3.8.1",
    "dotenv": "18.0.9",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@swc/core": "^1.16.20",
    "@vendure/cli": "3.8.1",
    "@vendure/testing": "^3.8.1",
    "nock": "^15.0.5",
    "sql.js": "^1.15.2",
    "ts-node": "10.9.2",
    "typescript": "5.8.2",
    "unplugin-swc": "^2.0.0",
    "vite": "7.3.7",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  }
}
