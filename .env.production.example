# Copy to .env.production (gitignored), fill in, and keep it only on the server. See docs/deployment.md.

# Domains (their DNS must point to the server). The shop and its API/Dashboard each get their own HTTPS domain.
SHOP_DOMAIN=shop.example.nl
API_DOMAIN=api.example.nl

# Secrets: long random values, e.g. `openssl rand -base64 48`
COOKIE_SECRET=
REVALIDATION_SECRET=
DB_PASSWORD=
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=

DB_NAME=vendure
DB_USERNAME=vendure

# Email (required): any SMTP provider, e.g. Resend, Postmark, Mailgun. 465 = TLS, 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM='"Laptopic" <bestellingen@example.nl>'

# Mollie TEST key (test_...). This project refuses live keys.
MOLLIE_API_KEY=

# Optional: path of a supplier stock/price CSV inside the server container; empty = nightly sync off.
SUPPLIER_FEED_PATH=
